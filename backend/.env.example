# LLM providers, tried in this order (next one on 429). Leave a key empty to skip it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Clear this if GROQ_MODEL is a model that rejects reasoning_effort (e.g. Llama).
GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=low

CORS_ORIGINS=http://localhost:3000

# Optional (defaults shown), `limits` syntax
# CHAT_RATE_LIMIT=6/minute;40/day
# CHAT_GLOBAL_RATE_LIMIT=30/minute;600/day
